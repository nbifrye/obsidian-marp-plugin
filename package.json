{
	"name": "marp-deck",
	"version": "0.1.0",
	"description": "Preview, present and export Marp slide decks in Obsidian with Marp Core v5.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -noEmit -skipLibCheck && tsc -p test -skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "npm run build && wdio run test/wdio.conf.mts",
		"test:e2e:android": "npm run build && wdio run test/wdio.android.conf.mts",
		"obsidian:launch": "npm run build && node scripts/obsidian-launch.mjs",
		"obsidian:cdp": "node scripts/obsidian-cdp.mjs",
		"sample-vault": "npm run build && node scripts/sample-vault.mjs"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.6.5",
		"@wdio/appium-service": "^9.32.0",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"@wdio/types": "^9.32.0",
		"appium": "^3.8.0",
		"appium-uiautomator2-driver": "^8.7.0",
		"chrome-remote-interface": "^0.34.0",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.3",
		"jiti": "^2.7.0",
		"mocha": "^12.0.3",
		"obsidian": "latest",
		"obsidian-launcher": "^3.3.0",
		"prettier": "3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5",
		"wdio-obsidian-reporter": "^3.3.0",
		"wdio-obsidian-service": "^3.3.0",
		"webdriverio": "^9.32.0",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"@marp-team/marp-core": "^5.0.2",
		"@marp-team/marpit": "^3.2.3",
		"@mathjax/mathjax-bbm-font-extension": "^4.1.3",
		"@mathjax/mathjax-bboldx-font-extension": "^4.1.3",
		"@mathjax/mathjax-dsfont-font-extension": "^4.1.3",
		"@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
		"@mathjax/src": "^4.1.3",
		"beautiful-mermaid": "^1.1.3",
		"katex": "^0.18.10",
		"shiki": "^4.5.0"
	}
}
